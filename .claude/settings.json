{
  "model": "claude-opus-5",

  "permissions": {
    "allow": [
      "Bash(*)",
      "Read",
      "Write",
      "Edit",
      "WebFetch",
      "WebSearch",
      "NotebookRead",
      "NotebookEdit",
      "mcp__sequential-thinking__*",
      "mcp__filesystem__*",
      "mcp__fetch__*",
      "mcp__memory__*",
      "mcp__brave-search__*",
      "mcp__puppeteer__*",
      "mcp__exa__*",
      "mcp__smartentry__*"
    ],
    "deny": []
  },

  "mcpServers": {
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem",
        "C:/Users/User/ai-trading-dashboard",
        "C:/Users/User/Documents",
        "C:/Users/User/Desktop",
        "C:/Users/User/AppData/Local/Microsoft/Edge/SmartEntryTV"
      ]
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    },
    "exa": {
      "command": "npx",
      "args": ["-y", "exa-mcp-server"],
      "env": {
        "EXA_API_KEY": "${EXA_API_KEY}"
      }
    },
    "puppeteer": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"],
      "env": {
        "PUPPETEER_LAUNCH_OPTIONS": "{\"headless\":false,\"executablePath\":\"C:\\\\Program Files (x86)\\\\Microsoft\\\\Edge\\\\Application\\\\msedge.exe\",\"userDataDir\":\"C:\\\\Users\\\\User\\\\AppData\\\\Local\\\\Microsoft\\\\Edge\\\\SmartEntryTV\",\"args\":[\"--start-maximized\",\"--no-first-run\"]}"
      }
    },
    "smartentry": {
      "command": "node",
      "args": ["C:/Users/User/ai-trading-dashboard/server/mcp_server.js"]
    },
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -File 'C:\\Users\\User\\ai-trading-dashboard\\tasks\\hooks\\git-safety.ps1'",
            "shell": "powershell",
            "async": true
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "Set-Location 'C:\\Users\\User\\ai-trading-dashboard'; $files = git diff --name-only HEAD 2>$null; foreach ($f in $files) { if ($f -match '\\.js$') { node --check $f 2>$null } elseif ($f -match '\\.py$') { python -m py_compile $f 2>$null } }; if (git status --porcelain 2>$null) { git add -A; $changed = (git diff --cached --name-only 2>$null) -join ', '; $msg = if ($changed) { \"update $changed\" } else { 'auto-save' }; git commit -m $msg --quiet }",
            "shell": "powershell",
            "async": true,
            "statusMessage": "Validating + auto-saving..."
          }
        ]
      }
    ],

    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "try { $s = curl.exe -s --max-time 3 http://localhost:3001/api/signals 2>$null; $r = curl.exe -s --max-time 3 http://localhost:3001/api/risk-status 2>$null; \"$s $r\" } catch { '{\"offline\":true}' }",
            "shell": "powershell",
            "async": true,
            "statusMessage": "Checking SmartEntry..."
          },
          {
            "type": "command",
            "command": "Set-Location 'C:\\Users\\User\\ai-trading-dashboard'; $today = Get-Date -Format 'yyyyMMdd'; $flag = \"tasks\\.auto_runner_$today\"; if (-not (Test-Path $flag)) { python auto_runner.py --silent 2>$null; New-Item $flag -Force | Out-Null }",
            "shell": "powershell",
            "async": true,
            "statusMessage": "Running daily auto-check..."
          }
        ]
      }
    ],

    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -File 'C:\\Users\\User\\ai-trading-dashboard\\tasks\\hooks\\session-stop.ps1'",
            "shell": "powershell",
            "async": true
          }
        ]
      }
    ]
  },

  "autoCompactEnabled": true,
  "alwaysThinkingEnabled": true
}
