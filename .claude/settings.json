{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read",
      "Write",
      "Edit",
      "WebFetch",
      "WebSearch",
      "NotebookRead",
      "NotebookEdit",
      "mcp__sequential-thinking__*",
      "mcp__filesystem__*",
      "mcp__fetch__*",
      "mcp__memory__*",
      "mcp__brave-search__*"
    ],
    "deny": []
  },

  "mcpServers": {
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem",
        "C:/Users/User/ai-trading-dashboard",
        "C:/Users/User/Documents"
      ]
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    }
  },

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd /d C:\\Users\\User\\ai-trading-dashboard && git diff --quiet HEAD 2>nul || (git add -A && git commit -m \"auto-save\" --quiet)",
            "shell": "powershell",
            "async": true,
            "statusMessage": "Auto-saving..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s --max-time 3 http://localhost:3001/api/signals 2>nul && curl -s --max-time 3 http://localhost:3001/api/risk-status 2>nul || echo {\"offline\":true}",
            "shell": "powershell",
            "async": true,
            "statusMessage": "Checking SmartEntry..."
          }
        ]
      }
    ]
  },

  "autoCompactEnabled": true,
  "alwaysThinkingEnabled": true
}
