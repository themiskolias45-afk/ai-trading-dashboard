{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read",
      "Write",
      "Edit",
      "WebFetch",
      "WebSearch",
      "NotebookRead",
      "NotebookEdit",
      "mcp__sequential-thinking__*",
      "mcp__filesystem__*",
      "mcp__fetch__*",
      "mcp__memory__*",
      "mcp__brave-search__*",
      "mcp__puppeteer__*",
      "mcp__exa__*"
    ],
    "deny": []
  },

  "mcpServers": {
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem",
        "C:/Users/User/ai-trading-dashboard",
        "C:/Users/User/Documents",
        "C:/Users/User/Desktop",
        "C:/Users/User/AppData/Local/Microsoft/Edge/SmartEntryTV"
      ]
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    },
    "exa": {
      "command": "npx",
      "args": ["-y", "exa-mcp-server"],
      "env": {
        "EXA_API_KEY": "${EXA_API_KEY}"
      }
    },
    "puppeteer": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"],
      "env": {
        "PUPPETEER_LAUNCH_OPTIONS": "{\"headless\":false,\"executablePath\":\"C:\\\\Program Files (x86)\\\\Microsoft\\\\Edge\\\\Application\\\\msedge.exe\",\"userDataDir\":\"C:\\\\Users\\\\User\\\\AppData\\\\Local\\\\Microsoft\\\\Edge\\\\SmartEntryTV\",\"args\":[\"--start-maximized\",\"--no-first-run\"]}"
      }
    }
  },

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd /d C:\\Users\\User\\ai-trading-dashboard && for /f \"delims=\" %f in ('git diff --name-only HEAD 2^>nul') do (if \"%~xf\"==\".js\" node --check \"%f\" 2^>nul && if \"%~xf\"==\".py\" python -m py_compile \"%f\" 2^>nul) & git diff --quiet HEAD 2>nul || (git add -A && git commit -m \"auto-save\" --quiet)",
            "shell": "cmd",
            "async": true,
            "statusMessage": "Validating + auto-saving..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s --max-time 3 http://localhost:3001/api/signals 2>nul && curl -s --max-time 3 http://localhost:3001/api/risk-status 2>nul || echo {\"offline\":true}",
            "shell": "powershell",
            "async": true,
            "statusMessage": "Checking SmartEntry..."
          }
        ]
      }
    ]
  },

  "autoCompactEnabled": true,
  "alwaysThinkingEnabled": true
}
