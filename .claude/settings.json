{
  "model": "claude-opus-5",

  "permissions": {
    "allow": [
      "Bash(*)",
      "Read",
      "Write",
      "Edit",
      "WebFetch",
      "WebSearch",
      "NotebookRead",
      "NotebookEdit",
      "mcp__sequential-thinking__*",
      "mcp__filesystem__*",
      "mcp__fetch__*",
      "mcp__memory__*",
      "mcp__brave-search__*",
      "mcp__puppeteer__*",
      "mcp__exa__*",
      "mcp__smartentry__*"
    ],
    "deny": []
  },

  "enableAllProjectMcpServers": true,

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& (Join-Path (Get-Item .).FullName 'tasks/hooks/git-safety.ps1')\"",
            "timeout": 15,
            "statusMessage": "Destructive-command check..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& (Join-Path (Get-Item .).FullName 'tasks/hooks/pre-edit-check.ps1')\""
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& (Join-Path (Get-Item .).FullName 'tasks/hooks/post-edit-check.ps1')\"",
            "statusMessage": "Quality + security check..."
          }
        ]
      }
    ],

    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& (Join-Path (Get-Item .).FullName 'tasks/hooks/startup-check.ps1')\"",
            "async": true,
            "statusMessage": "Running startup checks..."
          },
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& (Join-Path (Get-Item .).FullName 'tasks/hooks/daily-runner.ps1')\"",
            "async": true,
            "statusMessage": "Running daily AI analysis..."
          }
        ]
      }
    ],

    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& (Join-Path (Get-Item .).FullName 'tasks/hooks/session-stop.ps1')\"",
            "async": true
          }
        ]
      }
    ]
  },

  "autoCompactEnabled": true,
  "alwaysThinkingEnabled": true
}
