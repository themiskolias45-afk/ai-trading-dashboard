{
  "model": "claude-opus-5",

  "permissions": {
    "allow": [
      "Bash(*)",
      "Read",
      "Write",
      "Edit",
      "WebFetch",
      "WebSearch",
      "NotebookRead",
      "NotebookEdit",
      "mcp__sequential-thinking__*",
      "mcp__filesystem__*",
      "mcp__fetch__*",
      "mcp__memory__*",
      "mcp__brave-search__*",
      "mcp__puppeteer__*",
      "mcp__exa__*",
      "mcp__smartentry__*"
    ],
    "deny": []
  },

  "mcpServers": {
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem",
        "${USERPROFILE}/Documents",
        "${USERPROFILE}/Desktop"
      ]
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    },
    "exa": {
      "command": "npx",
      "args": ["-y", "exa-mcp-server"],
      "env": {
        "EXA_API_KEY": "${EXA_API_KEY}"
      }
    },
    "puppeteer": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"],
      "env": {
        "PUPPETEER_LAUNCH_OPTIONS": "{\"headless\":false,\"executablePath\":\"C:\\\\Program Files (x86)\\\\Microsoft\\\\Edge\\\\Application\\\\msedge.exe\",\"userDataDir\":\"${USERPROFILE}\\\\AppData\\\\Local\\\\Microsoft\\\\Edge\\\\SmartEntryTV\",\"args\":[\"--start-maximized\",\"--no-first-run\"]}"
      }
    },
    "smartentry": {
      "command": "node",
      "args": ["./server/mcp_server.js"]
    }
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -Command \"$p=(git rev-parse --show-toplevel 2>$null); if($p){& \\\"$p/tasks/hooks/git-safety.ps1\\\"}\"",
            "async": true
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -Command \"$p=(git rev-parse --show-toplevel 2>$null); if($p){& \\\"$p/tasks/hooks/pre-edit-check.ps1\\\"}\""
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -Command \"$p=(git rev-parse --show-toplevel 2>$null); if($p){& \\\"$p/tasks/hooks/post-edit-check.ps1\\\"}\"",
            "statusMessage": "Quality + security check..."
          }
        ]
      }
    ],

    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -Command \"$p=(git rev-parse --show-toplevel 2>$null); if($p){& \\\"$p/tasks/hooks/startup-check.ps1\\\"}\"",
            "async": true,
            "statusMessage": "Running startup checks..."
          },
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -Command \"$p=(git rev-parse --show-toplevel 2>$null); if($p){& \\\"$p/tasks/hooks/daily-runner.ps1\\\"}\"",
            "async": true,
            "statusMessage": "Running daily AI analysis..."
          }
        ]
      }
    ],

    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -Command \"$p=(git rev-parse --show-toplevel 2>$null); if($p){& \\\"$p/tasks/hooks/session-stop.ps1\\\"}\"",
            "async": true
          }
        ]
      }
    ]
  },

  "autoCompactEnabled": true,
  "alwaysThinkingEnabled": true
}
