//@version=5
indicator("JARVIS Daily Plan", shorttitle="JARVIS Daily Plan 08-26 07:08", overlay=true, max_lines_count=40, max_labels_count=40)

// Generated by JARVIS - 2026-08-26 07:08
// Covers: BTC, GOLD, SPX
// Levels come from the SmartEntry engine, not from this chart's own feed.

_sym = syminfo.ticker
_isBTC = str.contains(_sym, "BTC")
_isGOLD = str.contains(_sym, "XAU") or str.contains(_sym, "GOLD")
_isSPX = str.contains(_sym, "SPX") or str.contains(_sym, "SP500") or str.contains(_sym, "US500")
_known = _isBTC or _isGOLD or _isSPX

_planTs = 1787724488082
_planAgeHrs = (timenow - _planTs) / 3600000.0
_planStale = _planAgeHrs > 18.0
_planAgeSuffix = _planStale ? "  STALE " + str.tostring(_planAgeHrs, "#.#") + "h" : ""
_planAgeColor = _planStale ? color.red : color.white
_isSetup = _isBTC ? false : _isGOLD ? true : _isSPX ? false : false
_entry = _isBTC ? 78952.01 : _isGOLD ? 4638.68 : _isSPX ? 7677.35 : na
_entryTxt = _isBTC ? "Price 78,952.01" : _isGOLD ? "Entry 4,638.68" : _isSPX ? "Price 7,677.35" : ""
_stop = _isBTC ? 76042.21 : _isGOLD ? 4610.29 : _isSPX ? 7627.35 : na
_stopTxt = _isBTC ? "S2 76,042.21" : _isGOLD ? "Stop 4,610.29" : _isSPX ? "S2 7,627.35" : ""
_target = _isBTC ? 82337.15 : _isGOLD ? 4701.75 : _isSPX ? 7733.85 : na
_targetTxt = _isBTC ? "R2 82,337.15" : _isGOLD ? "Target 4,701.75" : _isSPX ? "R2 7,733.85" : ""

var table planTable = table.new(position.top_right, 2, 16,
     border_width=1, frame_width=1, frame_color=color.new(color.gray, 40),
     bgcolor=color.new(color.black, 15))

if barstate.islast and _known
    table.cell(planTable, 0, 0, (_isBTC ? "JARVIS BTC  08-26 07:08" : _isGOLD ? "JARVIS GOLD  08-26 07:08" : _isSPX ? "JARVIS SPX  08-26 07:08" : "JARVIS PLAN") + _planAgeSuffix, text_color=_planAgeColor, text_size=size.normal, text_halign=text.align_left)
    table.cell(planTable, 1, 0, _isBTC ? "WAIT" : _isGOLD ? "LONG" : _isSPX ? "WAIT" : "-", text_color=color.white, text_size=size.normal, text_halign=text.align_left, bgcolor=_isBTC ? color.new(color.gray, 0) : _isGOLD ? color.new(color.green, 0) : _isSPX ? color.new(color.gray, 0) : color.new(color.gray, 0))
    table.cell(planTable, 0, 1, "Entry", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 1, 1, _isBTC ? "78,952.01  (price)" : _isGOLD ? "4,638.68" : _isSPX ? "7,677.35  (price)" : "-", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 0, 2, "SL", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 1, 2, _isBTC ? "76,042.21  (S2 pivot)" : _isGOLD ? "4,610.29" : _isSPX ? "7,627.35  (S2 pivot)" : "-", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 0, 3, "TP", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 1, 3, _isBTC ? "82,337.15  (R2 pivot)" : _isGOLD ? "4,701.75" : _isSPX ? "7,733.85  (R2 pivot)" : "-", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 0, 4, "R:R", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 1, 4, _isBTC ? "n/a - no setup" : _isGOLD ? "2.22" : _isSPX ? "n/a - no setup" : "-", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 0, 5, "Levels", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 1, 5, _isBTC ? "PIVOT BAND - not a trade" : _isGOLD ? "engine setup" : _isSPX ? "PIVOT BAND - not a trade" : "-", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 0, 6, "Pivots", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 1, 6, _isBTC ? "R1 80,262.00  S1 77,114.53" : _isGOLD ? "R1 4,701.75  S1 4,610.29" : _isSPX ? "R1 7,708.50  S1 7,655.25  Brk+ 7,891.06  Brk- 7,499.97" : "-", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 0, 7, "Confidence", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 1, 7, _isBTC ? "0 vs gate 70  gap 70pt" : _isGOLD ? "74 vs gate 70  MEETS GATE" : _isSPX ? "0 vs gate 70  gap 70pt" : "-", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 0, 8, "Setup", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 1, 8, _isBTC ? "WAIT (D1)" : _isGOLD ? "MOMENTUM (D1)" : _isSPX ? "BB_SQUEEZE_WATCH (D1)" : "-", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 0, 9, "Regime", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 1, 9, _isBTC ? "TRENDING  RSI 82.4 ADX 37.5" : _isGOLD ? "TRENDING  RSI 70.5 ADX 36.5" : _isSPX ? "TRENDING  RSI 53.1 ADX 15.3" : "-", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 0, 10, "Trend D1", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 1, 10, _isBTC ? "STRONG UPTREND" : _isGOLD ? "STRONG UPTREND" : _isSPX ? "STRONG UPTREND" : "-", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 0, 11, "Trend H4", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 1, 11, _isBTC ? "STRONG UPTREND (RSI 61.2)" : _isGOLD ? "STRONG UPTREND (RSI 60.4)" : _isSPX ? "MIXED (RSI 45.4)" : "-", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 0, 12, "Trend H1", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 1, 12, _isBTC ? "UPTREND (RSI 49.8)" : _isGOLD ? "UPTREND (RSI 47.2)" : _isSPX ? "STRONG DOWNTREND (RSI 49.7)" : "-", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 0, 13, "1D read", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 1, 13, _isBTC ? "UP RSI>=70 -> 59.6% up  READ THIN (2/3 folds)" : _isGOLD ? "UP RSI>=70 -> 59.1% up  INSIDE NOISE (bar 8pp)" : _isSPX ? "UP RSI45-55 -> 51% up  INSIDE NOISE (bar 9.5pp)" : "-", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 0, 14, "4H read", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 1, 14, _isBTC ? "UP RSI>=70 -> 53.8% up  INSIDE NOISE (bar 4.6pp)" : _isGOLD ? "UP RSI55-70 -> 52.9% up  INSIDE NOISE (bar 3.7pp)" : _isSPX ? "DOWN RSI30-45 -> 48% up  INSIDE NOISE (bar 2.6pp)" : "-", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 0, 15, "Note", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(planTable, 1, 15, _isBTC ? "No setup — needs: RSI below 50 (now 82.4)" : _isGOLD ? "All EMAs aligned — trend structure intact" : _isSPX ? "BB bandwidth 4.7% — extreme squeeze, breakout imminent" : "-", text_color=color.white, text_size=size.small, text_halign=text.align_left)

    if _isSetup and not na(_entry)
        line.new(bar_index - 120, _entry, bar_index + 20, _entry, extend=extend.right, color=color.new(color.green, 0), width=2, style=line.style_solid)
        label.new(bar_index + 20, _entry, _entryTxt, color=color.new(color.green, 0), textcolor=color.white, style=label.style_label_left, size=size.small)
    if _isSetup and not na(_stop)
        line.new(bar_index - 120, _stop, bar_index + 20, _stop, extend=extend.right, color=color.new(color.red, 0), width=2, style=line.style_dashed)
        label.new(bar_index + 20, _stop, _stopTxt, color=color.new(color.red, 0), textcolor=color.white, style=label.style_label_left, size=size.small)
    if _isSetup and not na(_target)
        line.new(bar_index - 120, _target, bar_index + 20, _target, extend=extend.right, color=color.new(color.blue, 0), width=2, style=line.style_dashed)
        label.new(bar_index + 20, _target, _targetTxt, color=color.new(color.blue, 0), textcolor=color.white, style=label.style_label_left, size=size.small)
    if _isSetup and not na(_entry) and not na(_stop)
        box.new(bar_index - 120, math.max(_entry, _stop), bar_index + 20, math.min(_entry, _stop), border_color=color.new(color.red, 70), bgcolor=color.new(color.red, 88), extend=extend.right)
    if _isSetup and not na(_entry) and not na(_target)
        box.new(bar_index - 120, math.max(_entry, _target), bar_index + 20, math.min(_entry, _target), border_color=color.new(color.green, 70), bgcolor=color.new(color.green, 88), extend=extend.right)
