<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Scores past pre-open plans against the journal. Reporting only - changes no threshold, feeds no gate.</Description>
    <URI>\SmartEntry Pre-Open Score</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>S-1-5-21-2347431230-2969591567-1246811716-1001</UserId>
      <LogonType>InteractiveToken</LogonType>
