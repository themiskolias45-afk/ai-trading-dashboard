<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Samples NAS100/SP500 broker spreads every 5 min for one session, to settle the SP500-&gt;NAS100 swap on measured cost.</Description>
    <URI>\SmartEntry Spread Probe</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>S-1-5-21-2347431230-2969591567-1246811716-1001</UserId>
      <LogonType>InteractiveToken</LogonType>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT4M</ExecutionTimeLimit>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <StartWhenAvailable>true</StartWhenAvailable>
    <IdleSettings>
      <Duration>PT10M</Duration>
      <WaitTimeout>PT1H</WaitTimeout>
      <StopOnIdleEnd>true</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers>
    <TimeTrigger>
      <StartBoundary>2026-09-07T08:00:00+01:00</StartBoundary>
      <Repetition>
        <Interval>PT5M</Interval>
        <Duration>PT12H</Duration>
        <StopAtDurationEnd>true</StopAtDurationEnd>
      </Repetition>
    </TimeTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Users\User\AppData\Local\Programs\Python\Python312\python.exe</Command>
      <Arguments>"C:\Users\User\ai-trading-dashboard\tasks\spread_probe.py"</Arguments>
      <WorkingDirectory>C:\Users\User\ai-trading-dashboard</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
