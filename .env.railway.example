# Copy these into Railway → your project → Variables tab
# DO NOT commit actual values — this file shows the names only

# Required — AI brain
ANTHROPIC_API_KEY=sk-ant-...

# Required — database path (Railway Volume must be mounted at /data)
DB_PATH=/data/smartentry.db

# Optional — Telegram alerts
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — market search
BRAVE_API_KEY=

# Optional — Unusual Whales (congress + options flow)
UW_API_KEY=

# Optional — OpenAI (if used)
OPENAI_API_KEY=
