# Smart Entry Pro — Environment Variables
# Copy this file to .env and fill in your values

# Telegram Bot Token (required for alerts)
TELEGRAM_TOKEN=your_telegram_token_here

# Server port (default: 4000)
PORT=4000

# Binance API credentials (required for LIVE auto-trading, optional for PAPER mode)
# Create at: https://www.binance.com/en/my/settings/api-management
# Enable: Spot Trading only (no withdrawal permission needed)
BINANCE_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_api_secret_here

# Set to true when running npm run serve (production mode — serves built frontend)
SERVE_STATIC=false
