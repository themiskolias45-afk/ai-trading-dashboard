# SmartEntry Pro — Environment Variables
# Copy this file to .env and fill in your keys
# Then start the server with: node -r dotenv/config index.js
# Or set them in Windows: set ANTHROPIC_API_KEY=your_key_here

# ── Claude AI (enables full AI chat on the dashboard) ─────────
# Get your key from: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Unusual Whales (enables congress trades + options flow) ───
# Get your key from: https://unusualwhales.com/api
UW_API_KEY=

# ── Server ────────────────────────────────────────────────────
PORT=3001

# ── MT5 Bridge settings (optional) ────────────────────────────
SMARTENTRY_URL=http://localhost:3001
RISK_PERCENT=1.0
MAX_SPREAD=50
POLL_INTERVAL=60
