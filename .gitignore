# Globbed, not exact: a keys.env.bak is exactly as sensitive as keys.env, and
# taking a .bak before editing the file is a normal thing to do (the VPS now has
# one). An exact-match rule would have left that copy trackable.
keys.env*
apikey.txt*
# Signs dashboard session cookies. Same trust boundary as the keys above:
# whoever holds it can forge a logged-in session.
server/session_secret.txt
node_modules/
*.log
__pycache__/
*.pyc
tasks/logs/
tasks/backups/
vps-backups/
tasks/.tv_session.json
# Per-machine, per-account circuit breaker counters. Live runtime state: tracking
# it would let a git pull overwrite one machine's loss streak with another's.
tasks/breaker_state_*.json
tasks/*.pine

# Exported MT5 bars — large and regenerable via tasks/export_mt5_history.py
tasks/history/

# Analysis output — ~400KB per run (report + fact pack + analyst replies) and
# fully regenerable by parallel_analysis.py. The server reads latest.json from
# disk, so nothing depends on these being in git.
tasks/analysis/

# Per-machine live state: a halt is a local safety decision and must never
# deploy from one box to another, and the VPS keeps its own copy untracked.
server/trading_control.json
